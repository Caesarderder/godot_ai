{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Builda Godot micro-recipe manifest",
  "type": "object",
  "required": [
    "id",
    "category",
    "summary",
    "canonical_owner",
    "target",
    "dependencies",
    "autoloads",
    "input_actions",
    "public_contract",
    "files",
    "demo_scene",
    "test_script",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "category": {
      "enum": ["architecture", "gameplay", "ui", "testing"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "canonical_owner": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "target": {
      "type": "object",
      "required": ["engine", "language", "platform", "renderer", "threading"],
      "properties": {
        "engine": { "const": "Godot 4.6.x" },
        "language": { "const": "GDScript" },
        "platform": { "const": "Web" },
        "renderer": { "const": "Compatibility" },
        "threading": { "const": "single" }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "autoloads": {
      "type": "array",
      "items": { "type": "string" }
    },
    "input_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "public_contract": {
      "type": "object",
      "required": ["signals", "resources", "required_nodes"],
      "properties": {
        "signals": { "type": "array", "items": { "type": "string" } },
        "resources": { "type": "array", "items": { "type": "string" } },
        "required_nodes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "demo_scene": {
      "type": "string"
    },
    "test_script": {
      "type": "string"
    },
    "composes_with": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provenance": {
      "type": "object",
      "required": ["kind", "upstream_code_copied", "references"],
      "properties": {
        "kind": { "const": "builda-owned-original" },
        "upstream_code_copied": { "const": false },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
