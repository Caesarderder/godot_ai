{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caesar.local/schemas/caesar-awesome/evidence.schema.json",
  "title": "Caesar Loop EvidenceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "run_id",
    "revision",
    "valid_through_revision",
    "gate_id",
    "claim",
    "scenario_id",
    "execution_id",
    "evidence_type",
    "artifact_or_command",
    "case_results",
    "artifact_manifest",
    "environment",
    "grader",
    "observation",
    "result",
    "freshness",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "caesar-loop/v2" },
    "evidence_id": { "type": "string", "pattern": "^ev_[a-zA-Z0-9._-]+$" },
    "run_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "valid_through_revision": { "type": "string", "minLength": 1 },
    "gate_id": { "type": "string", "minLength": 1 },
    "claim": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": "string", "minLength": 1 },
    "execution_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "evidence_type": {
      "enum": [
        "build",
        "test",
        "runtime_state",
        "capture",
        "video",
        "visual_diff",
        "performance_profile",
        "model_critique",
        "player_observation"
      ]
    },
    "artifact_or_command": { "type": "string", "minLength": 1 },
    "case_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "result", "assertions", "artifacts"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail", "not_run", "unsupported"] },
          "assertions": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "artifacts": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        }
      }
    },
    "artifact_manifest": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["engine", "platform"],
      "properties": {
        "engine": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "device": { "type": "string" },
        "viewport": { "type": "string" },
        "seed": { "type": ["integer", "string", "null"] },
        "build_mode": { "type": "string" }
      }
    },
    "grader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version", "independence"],
      "properties": {
        "kind": { "enum": ["code", "runtime", "diff", "model", "human"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "independence": { "enum": ["not_applicable", "independent", "non_independent"] },
        "agent_thread_id": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "const": "model" },
              "independence": { "const": "independent" }
            },
            "required": ["kind", "independence"]
          },
          "then": { "required": ["agent_thread_id"] }
        }
      ]
    },
    "observation": { "type": "string", "minLength": 1 },
    "inference": { "type": "string" },
    "result": { "enum": ["pass", "fail", "directional", "not_run", "human_required", "unsupported"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "freshness": { "enum": ["current", "stale"] },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string" }
  }
}
