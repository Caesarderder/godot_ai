[node name="LoopHeading" type="Label" parent="HelpLandscapeColumns/HelpGameplayScroll/GameplayCards/LoopCard/Margin/Content"]
layout_mode = 2
text = "核心循环"

[node name="LoopBody" type="Label" parent="HelpLandscapeColumns/HelpGameplayScroll/GameplayCards/LoopCard/Margin/Content"]
layout_mode = 2
text = "收取三种工厂资源 → 培养永久军团 → 调整 2×3 阵位 → 主动攻城 → 用战果扩建并挑战下一城。"
autowrap_mode = 2

