[node name="GrowthBody" type="Label" parent="HelpLandscapeColumns/HelpGameplayScroll/GameplayCards/GrowthCard/Margin/Content"]
layout_mode = 2
text = "冲锋二星偏向更快突破前线，装甲二星偏向稳定承伤。比较战力变化、敌方威胁和阵位职责，再决定把资源投给谁。"
